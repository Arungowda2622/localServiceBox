{
  "expo": {
    "name": "Servioo",
    "slug": "localServiceBox",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.arun03.localServiceBox",
      "buildNumber": "8",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "config": {
        "googleMapsApiKey": "AIzaSyDwOFrgNmM51uT1F1zg_L0Em5ujW9obcHk"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Your location is used to automatically detect your pickup and delivery addresses, show them on the map, and calculate accurate routes, distance, and delivery charges. You can also enter addresses manually without sharing your location."
      }
    },
    "android": {
      "package": "com.arun03.localServiceBox",
      "versionCode": 8,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFA500"
      },
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDwOFrgNmM51uT1F1zg_L0Em5ujW9obcHk"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png",
          "color": "#007bff",
          "mode": "production"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "updates": {
      "url": "https://u.expo.dev/d302719d-343d-4324-9ceb-b12bb76807bc",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
