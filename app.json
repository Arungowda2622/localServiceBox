{
  "expo": {
    "name": "Servio",
    "slug": "localServiceBox",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "expoGoDGEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "config": {
        "googleMapsApiKey": "AIzaSyDwOFrgNmM51uT1F1zg_L0Em5ujW9obcHk"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFA500"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.arun03.localServiceBox",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDwOFrgNmM51uT1F1zg_L0Em5ujW9obcHk"
        }
      },
      "googleServicesFile": "./google-services.json",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png",
          "color": "#007bff",
          "mode": "production"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d302719d-343d-4324-9ceb-b12bb76807bc"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/d302719d-343d-4324-9ceb-b12bb76807bc",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
